#!/usr/bin/env bash
# openhands-cloud — one discoverable command interface for this Cursor cloud
# workspace, composing the existing repo commands (make, poetry, pnpm, curl).
#
# Design guarantees:
#   * every subcommand has help;
#   * checks are NON-MUTATING (biome check / verify — never --write);
#   * pnpm and poetry are resolved deterministically from PATH (no hardcoded
#     corepack; Node installs without Corepack are supported);
#   * `start` tracks its OWN process group in a PID/state file and only ever
#     stops processes it owns — foreign processes on the app ports are reported,
#     never killed;
#   * `doctor` emits a machine-readable report via a real JSON serializer
#     (python3) with contract/base/head + per-check command/exit + hashes;
#   * secret NAMES only are reported, never values.
#
# Sourceable for tests: set OHC_LIB_ONLY=1 to load the functions without
# executing main.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_PORT="${BACKEND_PORT:-3000}"
FRONTEND_PORT="${FRONTEND_PORT:-12000}"
BACKEND="http://127.0.0.1:${BACKEND_PORT}"
FRONTEND="http://127.0.0.1:${FRONTEND_PORT}"
REPORT="${OHC_REPORT:-/tmp/openhands-cloud-doctor.json}"
LOG="${OHC_LOG:-/tmp/openhands-cloud.log}"
RUNTIME_DIR="${OHC_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/openhands-cloud}"
STATE_FILE="$RUNTIME_DIR/app.state.json"
FROZEN_BASE_SHA="1f43ce8112653f1f05e5b6bf0caf1534beb6114d"

# Every provider secret NAME we recognize (values are NEVER read or printed).
SECRET_NAMES=(
  CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY
  OPENAI_API_KEY CODEX_API_KEY OPENAI_BASE_URL
  GEMINI_API_KEY GOOGLE_API_KEY GOOGLE_APPLICATION_CREDENTIALS
  OPENROUTER_API_KEY MISTRAL_API_KEY DEEPSEEK_API_KEY GROQ_API_KEY MOONSHOT_API_KEY
  AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_BEARER_TOKEN_BEDROCK
  AZURE_API_KEY VERTEXAI_PROJECT
  LLM_API_KEY
)

c_green() { printf '\033[32m%s\033[0m\n' "$1"; }
c_red() { printf '\033[31m%s\033[0m\n' "$1"; }
log() { printf '[openhands-cloud] %s\n' "$*" >&2; }

http_code() { curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$1" 2>/dev/null; }

# ---------------------------------------------------------- tool resolution
# Resolve pnpm deterministically: prefer a PATH pnpm (works on Node installs
# without Corepack), else the repo-pinned version via npx, else corepack if it
# exists. Never assume corepack.
_PNPM=()
resolve_pnpm() {
  if [ ${#_PNPM[@]} -gt 0 ]; then return 0; fi
  if command -v pnpm >/dev/null 2>&1; then
    _PNPM=(pnpm)
    return 0
  fi
  local pinned=""
  if command -v node >/dev/null 2>&1; then
    pinned="$(node -e "const p=require('$REPO_ROOT/quantum-agent/package.json').packageManager||'';process.stdout.write(p.replace(/^pnpm@/,''))" 2>/dev/null || true)"
  fi
  if [ -n "$pinned" ] && command -v npx >/dev/null 2>&1; then
    _PNPM=(npx --yes "pnpm@$pinned")
    return 0
  fi
  if command -v corepack >/dev/null 2>&1; then
    _PNPM=(corepack pnpm)
    return 0
  fi
  return 1
}

qa_pnpm() {
  resolve_pnpm || {
    echo "pnpm not resolvable (install pnpm or Node with npx)"
    return 127
  }
  (cd "$REPO_ROOT/quantum-agent" && "${_PNPM[@]}" "$@")
}

# Resolve poetry: prefer a workspace-native / PATH poetry, else the pipx
# location, else uv-run poetry if available.
_POETRY=()
resolve_poetry() {
  if [ ${#_POETRY[@]} -gt 0 ]; then return 0; fi
  if command -v poetry >/dev/null 2>&1; then
    _POETRY=("$(command -v poetry)")
    return 0
  fi
  if [ -x "$HOME/.local/bin/poetry" ]; then
    _POETRY=("$HOME/.local/bin/poetry")
    return 0
  fi
  if command -v uv >/dev/null 2>&1; then
    _POETRY=(uv run poetry)
    return 0
  fi
  return 1
}

qa_poetry() {
  resolve_poetry || {
    echo "poetry not resolvable"
    return 127
  }
  (cd "$REPO_ROOT" && "${_POETRY[@]}" "$@")
}

usage() {
  cat <<'EOF'
openhands-cloud — cloud workspace control surface

USAGE:
  openhands-cloud <command> [args]

COMMANDS:
  setup             Install backend (poetry) + frontend (npm ci) dependencies (idempotent).
  start             Start backend + frontend (RUNTIME=local) in their own process group;
                    refuses to touch foreign processes on the app ports.
  stop              Stop only the processes this tool started (by tracked PGID).
  status            Show ports, git branch, and running services.
  health            Check backend + frontend HTTP health. Exit non-zero on failure.
  verify            Run quantum README-contract verify (non-mutating).
  doctor            Full diagnosis with bounded repair+rerun; writes a JSON report to $OHC_REPORT.
  skill-new <desc>  Draft a new skill from a description (delegates to quantum skill new).
  skill-validate <path>   Validate a SKILL.md frontmatter + lowercase-hyphenated name (format only; no script execution).
  help              Show this help.

ENV:
  BACKEND_PORT (3000), FRONTEND_PORT (12000), OHC_REPORT, OHC_LOG,
  OHC_RUNTIME_DIR (PID/state dir, default $XDG_RUNTIME_DIR/openhands-cloud).
EOF
}

# ------------------------------------------------------------ process helpers
# Durable ownership: a launch records the leader PID, its PGID, a per-launch
# nonce, the leader's start-time (so a reused PID is detected), and the repo.
# Kills are performed ONLY after ownership is verified, and only on the owned
# group — never a foreign process.

# The PGID of a live process (empty if gone).
pgid_of() { ps -o pgid= -p "$1" 2>/dev/null | tr -d ' '; }

# Stable per-boot start identity of a PID (Linux /proc field 22; ps fallback).
proc_starttime() {
  local pid="$1"
  if [ -r "/proc/$pid/stat" ]; then
    awk '{print $22}' "/proc/$pid/stat" 2>/dev/null
  else
    ps -o lstart= -p "$pid" 2>/dev/null | tr -s ' '
  fi
}

# Alive AND not a zombie (kill -0 alone reports zombies as alive).
proc_alive() {
  local st
  st="$(ps -o stat= -p "$1" 2>/dev/null | tr -d ' ')"
  [ -n "$st" ] || return 1
  case "$st" in
    Z*) return 1 ;;
    *) return 0 ;;
  esac
}

write_state() {
  local leader pgid nonce start
  leader="$1"
  pgid="$(pgid_of "$leader")"
  start="$(proc_starttime "$leader")"
  nonce="$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n' 2>/dev/null || echo "$RANDOM-$RANDOM-$RANDOM")"
  mkdir -p "$RUNTIME_DIR"
  OHC_L="$leader" OHC_G="$pgid" OHC_N="$nonce" OHC_S="$start" OHC_R="$REPO_ROOT" OHC_F="$STATE_FILE" \
    python3 -c '
import json, os, time
json.dump(
    {
        "leader_pid": os.environ["OHC_L"],
        "pgid": os.environ["OHC_G"],
        "nonce": os.environ["OHC_N"],
        "leader_starttime": os.environ["OHC_S"],
        "repo": os.environ["OHC_R"],
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    },
    open(os.environ["OHC_F"], "w"),
    indent=2,
)
'
}

_state_field() {
  [ -f "$STATE_FILE" ] || return 1
  python3 -c "import json,sys
try:
    d=json.load(open('$STATE_FILE'))
    v=d.get('$1','')
    sys.stdout.write('' if v is None else str(v))
except Exception:
    sys.exit(1)" 2>/dev/null
}

# Verify the recorded launch is genuinely ours and still running.
# Returns 0 and echoes the owned PGID; non-zero (with a reason on stderr) if the
# state is absent, stale, or the PID was reused by an unrelated process.
verify_owned() {
  local leader pgid nonce start repo cur_start cur_pgid
  leader="$(_state_field leader_pid || true)"
  pgid="$(_state_field pgid || true)"
  start="$(_state_field leader_starttime || true)"
  repo="$(_state_field repo || true)"
  nonce="$(_state_field nonce || true)"
  [ -n "$leader" ] && [ -n "$pgid" ] && [ -n "$nonce" ] || return 1
  if ! proc_alive "$leader"; then
    log "ownership: leader pid $leader not alive (stale state)"
    return 1
  fi
  cur_start="$(proc_starttime "$leader")"
  if [ "$cur_start" != "$start" ]; then
    log "ownership: pid $leader start-time changed ($start != $cur_start) — reused PID, refusing"
    return 1
  fi
  cur_pgid="$(pgid_of "$leader")"
  if [ "$cur_pgid" != "$pgid" ]; then
    log "ownership: pid $leader pgid changed ($pgid != $cur_pgid) — refusing"
    return 1
  fi
  if [ -n "$repo" ] && [ "$repo" != "$REPO_ROOT" ]; then
    log "ownership: state repo ($repo) != $REPO_ROOT — refusing"
    return 1
  fi
  echo "$pgid"
}

_have() { command -v "$1" >/dev/null 2>&1; }

# Which listener inspectors are usable here (deterministic order).
port_inspector() {
  # Test hooks: force a specific inspector, 'none', or 'fake' (with OHC_FAKE_RESULT).
  case "${OHC_PORT_INSPECTOR:-}" in
    none | fake) echo "$OHC_PORT_INSPECTOR"; return 0 ;;
    lsof | ss | fuser) echo "$OHC_PORT_INSPECTOR"; return 0 ;;
  esac
  if _have lsof; then echo lsof; return 0; fi
  if _have ss; then echo ss; return 0; fi
  if _have fuser; then echo fuser; return 0; fi
  echo "none"
}

# Each _inspect_* echoes EXACTLY one of:
#   "free"             inspector ran and confirmed NO listener
#   "pid <N>"          a listener exists and its PID is <N>
#   "listener-no-pid"  a listener exists but its PID is not obtainable
#   "error"            the inspector failed to execute/parse
# An error/no-pid is NEVER reported as free (fail-closed).

_inspect_lsof() {
  local port="$1" pids rc
  pids="$(lsof -nP -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null)"
  rc=$?
  if [ -n "$pids" ]; then
    echo "pid $(printf '%s' "$pids" | head -1)"
    return 0
  fi
  # lsof exits 0 (match) or 1 (no match) normally; empty output with rc<=1 is a
  # confirmed free port. Any other exit is an execution error.
  if [ "$rc" -le 1 ]; then echo "free"; else echo "error"; fi
}

_inspect_ss() {
  local port="$1" exists rc withpid pid
  # Existence (process-agnostic) — reliable without privileges.
  exists="$(ss -ltnH "sport = :$port" 2>/dev/null)"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "error"
    return 0
  fi
  if [ -z "$exists" ]; then
    echo "free"
    return 0
  fi
  # A listener exists — now try the process-aware query for its PID.
  withpid="$(ss -ltnpH "sport = :$port" 2>/dev/null)"
  pid="$(printf '%s' "$withpid" | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)"
  if [ -n "$pid" ]; then echo "pid $pid"; else echo "listener-no-pid"; fi
}

_inspect_fuser() {
  local port="$1" out rc pid
  out="$(fuser "$port/tcp" 2>/dev/null)"
  rc=$?
  pid="$(printf '%s' "$out" | tr -s ' ' '\n' | grep -E '^[0-9]+$' | head -1)"
  if [ -n "$pid" ]; then
    echo "pid $pid"
    return 0
  fi
  # fuser: rc 1 = no process holds the port (confirmed free); other rc = error.
  if [ "$rc" -eq 1 ]; then echo "free"; else echo "error"; fi
}

_inspect_fake() { echo "${OHC_FAKE_RESULT:-error}"; }

# Classify the listener on port $1:
#   owned | foreign:<pid>:<comm> | free | unknown:<reason>
port_ownership() {
  local port="$1" res pid owner ours
  case "$(port_inspector)" in
    none) echo "unknown:no-inspector"; return 0 ;;
    lsof) res="$(_inspect_lsof "$port")" ;;
    ss) res="$(_inspect_ss "$port")" ;;
    fuser) res="$(_inspect_fuser "$port")" ;;
    fake) res="$(_inspect_fake "$port")" ;;
    *) echo "unknown:no-inspector"; return 0 ;;
  esac
  case "$res" in
    free) echo "free"; return 0 ;;
    "pid "*) pid="${res#pid }" ;;
    listener-no-pid) echo "unknown:listener-without-pid"; return 0 ;;
    *) echo "unknown:inspector-error"; return 0 ;;
  esac
  owner="$(pgid_of "$pid")"
  ours="$(verify_owned 2>/dev/null || true)"
  if [ -n "$ours" ] && [ "$owner" = "$ours" ]; then
    echo "owned"
  else
    echo "foreign:$pid:$(ps -o comm= -p "$pid" 2>/dev/null | tr -d ' ')"
  fi
}

# ------------------------------------------------------------------ subcommands

cmd_setup() {
  log "backend deps (poetry install --with dev,test,runtime)"
  qa_poetry install --with dev,test,runtime || return 1
  log "frontend deps (npm ci)"
  (cd "$REPO_ROOT" && npm --prefix frontend ci) || return 1
  c_green "setup: OK"
}

cmd_stop() {
  local pgid leader
  if ! pgid="$(verify_owned)"; then
    log "stop: no owned/verified process group (absent, stale, or reused PID) — refusing to kill anything"
    rm -f "$STATE_FILE"
    return 0
  fi
  leader="$(_state_field leader_pid || true)"
  log "stop: terminating owned process group $pgid (leader $leader)"
  kill -TERM -- "-$pgid" 2>/dev/null || true
  # Bounded wait for graceful exit (liveness via ps state, not kill -0, so a
  # zombie cannot false-positive), then force-kill the group.
  local i
  for i in $(seq 1 10); do
    proc_alive "$leader" || break
    sleep 0.5
  done
  if proc_alive "$leader"; then
    log "stop: escalating to SIGKILL for group $pgid"
    kill -KILL -- "-$pgid" 2>/dev/null || true
  fi
  # Reap if the leader is our direct child (best-effort; harmless if detached).
  wait "$leader" 2>/dev/null || true
  rm -f "$STATE_FILE"
  c_green "stop: OK"
}

cmd_start() {
  export INSTALL_DOCKER=0 RUNTIME=local
  unset SESSION_API_KEY 2>/dev/null || true
  mkdir -p "$RUNTIME_DIR"

  # Restart is bounded: stop only OUR previous group first.
  cmd_stop >/dev/null 2>&1 || true

  # Fail-closed port pre-flight. An UNKNOWN result (no supported listener
  # inspector) or a FOREIGN holder aborts start — we never launch on an
  # unverifiable port and never kill a foreign process.
  local port own foreign=0 unknown=0
  for port in "$BACKEND_PORT" "$FRONTEND_PORT"; do
    own="$(port_ownership "$port")"
    case "$own" in
      unknown:*)
        c_red "port $port: cannot verify listeners (${own#unknown:}) — need a working inspector (lsof, ss, or fuser)"
        unknown=1
        ;;
      foreign:*)
        c_red "port $port occupied by foreign process (${own#foreign:}); not killing it"
        foreign=1
        ;;
    esac
  done
  [ "$unknown" -eq 1 ] && {
    c_red "start: REFUSED (fail-closed) — install lsof, ss, or fuser so ports can be verified before launch"
    return 1
  }
  [ "$foreign" -eq 1 ] && {
    c_red "start: aborted — free the foreign port(s) or change BACKEND_PORT/FRONTEND_PORT"
    return 1
  }

  # Launch in a NEW session/process group; record durable ownership metadata.
  setsid bash -c "cd '$REPO_ROOT' && exec make run \
      BACKEND_HOST=0.0.0.0 BACKEND_PORT='$BACKEND_PORT' \
      FRONTEND_HOST=0.0.0.0 FRONTEND_PORT='$FRONTEND_PORT'" \
    >>"$LOG" 2>&1 </dev/null &
  local leader=$!
  write_state "$leader"

  log "waiting for backend on :$BACKEND_PORT (max 90s)"
  local i
  for i in $(seq 1 90); do
    [ "$(http_code "$BACKEND/alive")" = "200" ] && {
      c_green "backend: up"
      break
    }
    sleep 1
  done
  [ "$(http_code "$BACKEND/alive")" = "200" ] || {
    c_red "backend did not become healthy"
    return 1
  }
  for i in $(seq 1 30); do
    [ "$(http_code "$FRONTEND/")" = "200" ] && {
      c_green "frontend: up"
      break
    }
    sleep 1
  done
}

cmd_status() {
  echo "repo    = $REPO_ROOT"
  echo "branch  = $(git -C "$REPO_ROOT" branch --show-current 2>/dev/null)"
  echo "head    = $(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null)"
  echo "backend = $(http_code "$BACKEND/alive") ($BACKEND/alive)"
  echo "frontend= $(http_code "$FRONTEND/") ($FRONTEND/)"
  echo "owned-pgid = $(verify_owned 2>/dev/null || echo none)"
}

cmd_health() {
  local a f
  a="$(http_code "$BACKEND/alive")"
  f="$(http_code "$FRONTEND/")"
  echo "backend /alive = $a"
  echo "frontend /     = $f"
  if [ "$a" = "200" ] && [ "$f" = "200" ]; then
    c_green "health: PASS"
    return 0
  fi
  c_red "health: FAIL"
  return 1
}

cmd_verify() {
  # Non-mutating README-contract verify.
  qa_pnpm exec tsx src/cli.ts verify
}

cmd_skill_new() {
  [ $# -ge 1 ] || {
    echo "usage: openhands-cloud skill-new <description>"
    return 2
  }
  qa_pnpm quantum skill new "$*"
}

cmd_skill_validate() {
  local path="${1:-}"
  [ -n "$path" ] || {
    echo "usage: openhands-cloud skill-validate <path-to-SKILL.md-or-dir>"
    return 2
  }
  [ -d "$path" ] && path="$path/SKILL.md"
  [ -f "$path" ] || {
    c_red "no SKILL.md at $path"
    return 1
  }
  python3 - "$path" <<'PY'
import sys, re
p = sys.argv[1]
text = open(p, encoding="utf-8").read()
m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
if not m:
    print(f"FAIL: {p}: missing YAML frontmatter"); sys.exit(1)
fm = m.group(1)
def field(name):
    mm = re.search(rf"^{name}:\s*(.+)$", fm, re.M)
    return mm.group(1).strip() if mm else None
name, desc = field("name"), field("description")
errs = []
if not name: errs.append("missing 'name'")
elif not re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", name): errs.append(f"name '{name}' not lowercase-hyphenated")
if not desc: errs.append("missing 'description'")
if len(text) < 80: errs.append("body too short")
if errs:
    print("FAIL: " + p + ": " + "; ".join(errs)); sys.exit(1)
print(f"PASS: {p} (name={name})")
PY
}

# --------------------------------------------------------------------- doctor
declare -a R_NAME R_STATUS R_MS R_EXIT R_CMD R_DETAIL

record() {
  R_NAME+=("$1")
  R_STATUS+=("$2")
  R_MS+=("$3")
  R_EXIT+=("$4")
  R_CMD+=("$5")
  R_DETAIL+=("$(printf '%s' "$6" | tr -d '\t' | tr '\n' ' ')")
}

run_check() { # name cmd-desc probe...
  local name="$1" cmd="$2"
  shift 2
  local t0 t1 out rc
  t0=$(date +%s%3N)
  out="$("$@" 2>&1)"
  rc=$?
  t1=$(date +%s%3N)
  local status="PASS"
  [ $rc -ne 0 ] && status="FAIL"
  record "$name" "$status" "$((t1 - t0))" "$rc" "$cmd" "$(printf '%s' "$out" | tail -1)"
  if [ "$status" = "PASS" ]; then
    c_green "  [PASS] $name (${R_MS[-1]}ms)"
  else
    c_red "  [FAIL] $name (${R_MS[-1]}ms): ${R_DETAIL[-1]}"
  fi
  return $rc
}

chk_install() {
  qa_poetry run python -c "import openhands" >/dev/null 2>&1 && [ -d "$REPO_ROOT/frontend/node_modules" ]
}
chk_backend() { [ "$(http_code "$BACKEND/alive")" = "200" ] && [ "$(http_code "$BACKEND/health")" = "200" ]; }
chk_frontend() { [ "$(http_code "$FRONTEND/")" = "200" ]; }
# Truthful name: this verifies the frontend BUILD TOOLCHAIN is present (vite),
# not that a production build succeeds (the full build runs in CI).
chk_build_toolchain() { [ -f "$REPO_ROOT/frontend/package.json" ] && [ -d "$REPO_ROOT/frontend/node_modules/vite" ]; }
chk_network() { [ "$(http_code https://api.github.com)" != "000" ]; }
chk_migration013() {
  qa_poetry run python - <<'PY' 2>/dev/null
import os, sqlite3, sys
db = os.path.expanduser(os.environ.get("OH_PERSISTENCE_DIR", "~/.openhands") + "/openhands.db")
try:
    c = sqlite3.connect(db)
    cols = [r[1] for r in c.execute("PRAGMA table_info(conversation_metadata)")]
    ver = c.execute("select version_num from alembic_version").fetchone()[0]
    sys.exit(0 if ("execution_status" in cols and int(ver) >= 13) else 1)
except Exception as e:
    print(e); sys.exit(1)
PY
}
chk_localsandbox() {
  local resp sid st
  resp="$(curl -s --max-time 40 -X POST "$BACKEND/api/v1/sandboxes" 2>/dev/null)"
  sid="$(printf '%s' "$resp" | python3 -c 'import sys,json
try: print(json.loads(sys.stdin.read()).get("id",""))
except Exception: print("")' 2>/dev/null)"
  [ -n "$sid" ] || {
    echo "$resp"
    return 1
  }
  st="$(curl -s "$BACKEND/api/v1/sandboxes?id=$sid" | python3 -c 'import sys,json
d=json.load(sys.stdin); print((d[0] if isinstance(d,list) else d).get("status",""))' 2>/dev/null)"
  curl -s -X DELETE "$BACKEND/api/v1/sandboxes/$sid?sandbox_id=$sid" >/dev/null 2>&1
  [ "$st" = "RUNNING" ]
}
chk_quantum() {
  # Non-mutating gate (biome check, NOT --write) + typecheck + tests + verify.
  qa_pnpm exec biome check . >/dev/null 2>&1 &&
    qa_pnpm exec tsc -p tsconfig.json --noEmit >/dev/null 2>&1 &&
    qa_pnpm exec vitest run >/dev/null 2>&1 &&
    qa_pnpm exec tsx src/cli.ts verify >/dev/null 2>&1
}
chk_repo_isolation() { python3 "$REPO_ROOT/scripts/check-repo-isolation.py" --repo-root "$REPO_ROOT" >/dev/null 2>&1; }
chk_secrets() {
  local found="" n
  for n in "${SECRET_NAMES[@]}"; do
    [ -n "${!n:-}" ] && found="$found $n"
  done
  [ -n "$found" ] && echo "present:$found" || echo "none set (live provider calls unavailable)"
  return 0
}

emit_report_json() {
  local out="$1" n=${#R_NAME[@]} i
  local contract_sha=""
  [ -f "$REPO_ROOT/experiments/contract.lock.json" ] &&
    contract_sha="$(python3 -c "import json;print(json.load(open('$REPO_ROOT/experiments/contract.lock.json')).get('bundle_sha256',''))" 2>/dev/null || true)"
  {
    for i in $(seq 0 $((n - 1))); do
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "${R_NAME[$i]}" "${R_STATUS[$i]}" "${R_MS[$i]}" "${R_EXIT[$i]}" "${R_CMD[$i]}" "${R_DETAIL[$i]}"
    done
  } | OHC_REPORT_OUT="$out" \
    OHC_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    OHC_HEAD_SHA="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || true)" \
    OHC_BASE_SHA="$(git -C "$REPO_ROOT" merge-base origin/main HEAD 2>/dev/null || echo "$FROZEN_BASE_SHA")" \
    OHC_CONTRACT_SHA="$contract_sha" \
    python3 -c '
import sys, json, hashlib, os
checks = []
for line in sys.stdin.read().splitlines():
    if not line:
        continue
    parts = line.split("\t")
    parts += [""] * (6 - len(parts))
    name, status, ms, exit_, cmd, detail = parts[:6]
    checks.append({
        "name": name, "status": status, "ms": int(ms or 0),
        "exit": int(exit_ or 0), "command": cmd, "detail": detail,
    })
checks_ser = json.dumps(checks, sort_keys=True, separators=(",", ":"))
report = {
    "generated_at": os.environ.get("OHC_TS", ""),
    "base_sha": os.environ.get("OHC_BASE_SHA", ""),
    "head_sha": os.environ.get("OHC_HEAD_SHA", ""),
    "contract_bundle_sha256": os.environ.get("OHC_CONTRACT_SHA", ""),
    "checks": checks,
    "checks_sha256": hashlib.sha256(checks_ser.encode()).hexdigest(),
}
with open(os.environ["OHC_REPORT_OUT"], "w") as f:
    f.write(json.dumps(report, indent=2) + "\n")
'
}

cmd_doctor() {
  R_NAME=()
  R_STATUS=()
  R_MS=()
  R_EXIT=()
  R_CMD=()
  R_DETAIL=()
  echo "== openhands-cloud doctor =="
  run_check install "poetry import openhands + frontend node_modules" chk_install || true
  run_check network "GET api.github.com" chk_network || true
  run_check secrets "provider secret NAMES present" chk_secrets || true

  if ! run_check backend "GET /alive + /health" chk_backend; then
    local backend_idx=$((${#R_NAME[@]} - 1))
    log "backend down — bounded repair (start), then one rerun"
    cmd_start >/dev/null 2>&1 || true
    if run_check backend-rerun "GET /alive + /health" chk_backend; then
      R_STATUS[backend_idx]="REPAIRED"
    fi
  fi
  run_check frontend "GET frontend /" chk_frontend || true
  run_check build-toolchain "frontend vite present" chk_build_toolchain || true
  run_check migration013 "alembic>=013 + execution_status" chk_migration013 || true
  run_check local-sandbox "POST /api/v1/sandboxes -> RUNNING" chk_localsandbox || true
  run_check quantum-green "biome check + tsc + vitest + verify" chk_quantum || true
  run_check repo-isolation "check-repo-isolation.py" chk_repo_isolation || true

  emit_report_json "$REPORT"
  echo "report: $REPORT"
  local fails=0 i
  for i in "${!R_STATUS[@]}"; do [ "${R_STATUS[$i]}" = "FAIL" ] && fails=$((fails + 1)); done
  if [ "$fails" -eq 0 ]; then
    c_green "doctor: PASS (all ${#R_NAME[@]} checks)"
    return 0
  fi
  c_red "doctor: FAIL ($fails/${#R_NAME[@]} checks failed)"
  return 1
}

# --------------------------------------------------------------------- dispatch
main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    status) cmd_status "$@" ;;
    health) cmd_health "$@" ;;
    verify) cmd_verify "$@" ;;
    doctor) cmd_doctor "$@" ;;
    skill-new) cmd_skill_new "$@" ;;
    skill-validate) cmd_skill_validate "$@" ;;
    help | -h | --help) usage ;;
    *)
      echo "unknown command: $cmd"
      echo
      usage
      exit 2
      ;;
  esac
}

if [ "${OHC_LIB_ONLY:-}" != "1" ]; then
  main "$@"
fi
