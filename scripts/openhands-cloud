#!/usr/bin/env bash
# openhands-cloud — one discoverable command interface for this Cursor cloud
# workspace. It composes the *existing* repo commands (make, poetry, curl,
# quantum) into a small, well-behaved surface: setup, start, status, health,
# verify, doctor, skill-new, skill-validate.
#
# Design rules honored here:
#   * every subcommand has help;
#   * retries are bounded (never an infinite loop);
#   * output is human-readable AND a machine-readable JSON artifact (doctor);
#   * failures are explicit with a non-zero exit code and a precise reason;
#   * secret *values* are never printed — only secret *names*.
#
# It is intentionally dependency-light (bash + curl + python3 + git) so it runs
# on a fresh Cursor cloud VM before any heavy install.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_PORT="${BACKEND_PORT:-3000}"
FRONTEND_PORT="${FRONTEND_PORT:-12000}"
BACKEND="http://127.0.0.1:${BACKEND_PORT}"
FRONTEND="http://127.0.0.1:${FRONTEND_PORT}"
REPORT="${OHC_REPORT:-/tmp/openhands-cloud-doctor.json}"
POETRY="${POETRY:-$HOME/.local/bin/poetry}"
LOG="${OHC_LOG:-/tmp/openhands-cloud.log}"

c_green() { printf '\033[32m%s\033[0m\n' "$1"; }
c_red()   { printf '\033[31m%s\033[0m\n' "$1"; }
log()     { printf '[openhands-cloud] %s\n' "$*" >&2; }

http_code() { curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$1" 2>/dev/null; }

usage() {
  cat <<'EOF'
openhands-cloud — cloud workspace control surface

USAGE:
  openhands-cloud <command> [args]

COMMANDS:
  setup             Install backend (poetry) + frontend (npm ci) dependencies (idempotent).
  start             Start backend + frontend (RUNTIME=local) and wait for health.
  status            Show ports, git branch, and running services.
  health            Check backend + frontend HTTP health. Exit non-zero on failure.
  verify            Run quantum README-contract verify + skill validation.
  doctor            Full diagnosis (install/start/build/secrets/network/migration013/
                    local-sandbox/frontend/backend) with bounded repair+rerun.
                    Writes a machine-readable report to $OHC_REPORT.
  skill-new <desc>  Draft a new skill from a description (delegates to quantum skill new).
  skill-validate <path>   Validate a SKILL.md's frontmatter + run its scripts if present.
  help              Show this help.

ENV:
  BACKEND_PORT (default 3000), FRONTEND_PORT (default 12000),
  OHC_REPORT (doctor json path), OHC_LOG (log path).
EOF
}

# ------------------------------------------------------------------ subcommands

cmd_setup() {
  log "backend deps (poetry install --with dev,test,runtime)"
  ( cd "$REPO_ROOT" && "$POETRY" install --with dev,test,runtime ) || return 1
  log "frontend deps (npm ci)"
  ( cd "$REPO_ROOT" && npm --prefix frontend ci ) || return 1
  c_green "setup: OK"
}

cmd_start() {
  export INSTALL_DOCKER=0 RUNTIME=local
  unset SESSION_API_KEY 2>/dev/null || true
  # Free the ports first so restart is idempotent (bounded, by PID).
  local pids pid
  for p in "$BACKEND_PORT" "$FRONTEND_PORT"; do
    pids=$(lsof -ti tcp:"$p" 2>/dev/null || true)
    for pid in $pids; do
      kill "$pid" 2>/dev/null || true
    done
  done
  # Fully detach: new session, stdio to the log, stdin from /dev/null. This
  # keeps the long-running frontend dev server from holding the caller's
  # stdout/stderr open (which would hang `doctor`).
  setsid bash -c "cd '$REPO_ROOT' && exec make run \
      BACKEND_HOST=0.0.0.0 BACKEND_PORT='$BACKEND_PORT' \
      FRONTEND_HOST=0.0.0.0 FRONTEND_PORT='$FRONTEND_PORT'" \
      >>"$LOG" 2>&1 < /dev/null &
  disown 2>/dev/null || true
  log "waiting for backend on :$BACKEND_PORT (max 90s)"
  for _ in $(seq 1 90); do
    [ "$(http_code "$BACKEND/alive")" = "200" ] && { c_green "backend: up"; break; }
    sleep 1
  done
  [ "$(http_code "$BACKEND/alive")" = "200" ] || { c_red "backend did not become healthy"; return 1; }
  for _ in $(seq 1 30); do
    [ "$(http_code "$FRONTEND/")" = "200" ] && { c_green "frontend: up"; break; }
    sleep 1
  done
}

cmd_status() {
  echo "repo    = $REPO_ROOT"
  echo "branch  = $(cd "$REPO_ROOT" && git branch --show-current 2>/dev/null)"
  echo "head    = $(cd "$REPO_ROOT" && git rev-parse --short HEAD 2>/dev/null)"
  echo "backend = $(http_code "$BACKEND/alive") ($BACKEND/alive)"
  echo "frontend= $(http_code "$FRONTEND/") ($FRONTEND/)"
}

cmd_health() {
  local a f
  a="$(http_code "$BACKEND/alive")"; f="$(http_code "$FRONTEND/")"
  echo "backend /alive = $a"; echo "frontend /     = $f"
  [ "$a" = "200" ] && [ "$f" = "200" ] && { c_green "health: PASS"; return 0; }
  c_red "health: FAIL"; return 1
}

cmd_verify() {
  ( cd "$REPO_ROOT/quantum-agent" && corepack pnpm quantum verify )
}

cmd_skill_new() {
  [ $# -ge 1 ] || { echo "usage: openhands-cloud skill-new <description>"; return 2; }
  ( cd "$REPO_ROOT/quantum-agent" && corepack pnpm quantum skill new "$*" )
}

cmd_skill_validate() {
  local path="${1:-}"
  [ -n "$path" ] || { echo "usage: openhands-cloud skill-validate <path-to-SKILL.md-or-dir>"; return 2; }
  [ -d "$path" ] && path="$path/SKILL.md"
  [ -f "$path" ] || { c_red "no SKILL.md at $path"; return 1; }
  python3 - "$path" <<'PY'
import sys, re
p = sys.argv[1]
text = open(p, encoding="utf-8").read()
m = re.match(r"^---\n(.*?)\n---\n", text, re.S)
if not m:
    print(f"FAIL: {p}: missing YAML frontmatter"); sys.exit(1)
fm = m.group(1)
def field(name):
    mm = re.search(rf"^{name}:\s*(.+)$", fm, re.M)
    return mm.group(1).strip() if mm else None
name, desc = field("name"), field("description")
errs = []
if not name: errs.append("missing 'name'")
elif not re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", name): errs.append(f"name '{name}' not lowercase-hyphenated")
if not desc: errs.append("missing 'description'")
if len(text) < 80: errs.append("body too short")
if errs:
    print("FAIL: " + p + ": " + "; ".join(errs)); sys.exit(1)
print(f"PASS: {p} (name={name})")
PY
}

# --------------------------------------------------------------------- doctor
# A bounded, self-healing diagnosis. Each check runs once; transient checks get
# ONE repair attempt (start the app) and ONE rerun. Never loops unboundedly.

declare -a R_NAME R_STATUS R_MS R_DETAIL

record() { R_NAME+=("$1"); R_STATUS+=("$2"); R_MS+=("$3"); R_DETAIL+=("$4"); }

run_check() { # name cmd  -> echoes status, records timing
  local name="$1"; shift
  local t0 t1 out rc
  t0=$(date +%s%3N)
  out="$("$@" 2>&1)"; rc=$?
  t1=$(date +%s%3N)
  local status="PASS"; [ $rc -ne 0 ] && status="FAIL"
  record "$name" "$status" "$(( t1 - t0 ))" "$(echo "$out" | tail -1 | tr '"' "'" )"
  if [ "$status" = "PASS" ]; then
    c_green "  [PASS] $name (${R_MS[-1]}ms)"
  else
    c_red "  [FAIL] $name (${R_MS[-1]}ms): ${R_DETAIL[-1]}"
  fi
  return $rc
}

chk_install() { [ -x "$POETRY" ] && "$POETRY" -C "$REPO_ROOT" run python -c "import openhands" >/dev/null 2>&1 \
                && [ -d "$REPO_ROOT/frontend/node_modules" ]; }
chk_backend()  { [ "$(http_code "$BACKEND/alive")" = "200" ] && [ "$(http_code "$BACKEND/health")" = "200" ]; }
chk_frontend() { [ "$(http_code "$FRONTEND/")" = "200" ]; }
chk_build()    { [ -f "$REPO_ROOT/frontend/package.json" ] && [ -d "$REPO_ROOT/frontend/node_modules/vite" ]; }
chk_network()  { [ "$(http_code https://api.github.com)" != "000" ]; }
chk_migration013() {
  "$POETRY" -C "$REPO_ROOT" run python - <<'PY' 2>/dev/null
import os, sqlite3, sys
db = os.path.expanduser(os.environ.get("OH_PERSISTENCE_DIR", "~/.openhands") + "/openhands.db")
try:
    c = sqlite3.connect(db)
    cols = [r[1] for r in c.execute("PRAGMA table_info(conversation_metadata)")]
    ver = c.execute("select version_num from alembic_version").fetchone()[0]
    sys.exit(0 if ("execution_status" in cols and int(ver) >= 13) else 1)
except Exception as e:
    print(e); sys.exit(1)
PY
}
chk_localsandbox() {
  local resp sid st
  resp="$(curl -s --max-time 40 -X POST "$BACKEND/api/v1/sandboxes" 2>/dev/null)"
  sid="$(echo "$resp" | python3 -c 'import sys,json;
try: print(json.loads(sys.stdin.read()).get("id",""))
except Exception: print("")' 2>/dev/null)"
  [ -n "$sid" ] || { echo "$resp"; return 1; }
  st="$(curl -s "$BACKEND/api/v1/sandboxes?id=$sid" | python3 -c 'import sys,json;
d=json.load(sys.stdin); print((d[0] if isinstance(d,list) else d).get("status",""))' 2>/dev/null)"
  curl -s -X DELETE "$BACKEND/api/v1/sandboxes/$sid?sandbox_id=$sid" >/dev/null 2>&1
  [ "$st" = "RUNNING" ]
}
chk_quantum()  { ( cd "$REPO_ROOT/quantum-agent" && corepack pnpm green >/dev/null 2>&1 ); }
chk_repo_isolation() { python3 "$REPO_ROOT/scripts/check-repo-isolation.py" --repo-root "$REPO_ROOT" >/dev/null 2>&1; }
chk_secrets()  {
  # Non-failing informational check: report which known secret NAMES are set.
  local found=""
  for n in CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY OPENAI_API_KEY LLM_API_KEY; do
    [ -n "${!n:-}" ] && found="$found $n"
  done
  [ -n "$found" ] && echo "present:$found" || echo "none set (live provider calls unavailable)"
  return 0
}

cmd_doctor() {
  R_NAME=(); R_STATUS=(); R_MS=(); R_DETAIL=()
  echo "== openhands-cloud doctor =="
  run_check install       chk_install || true
  run_check network       chk_network || true
  run_check secrets       chk_secrets || true

  # Backend is a transient service: if down, attempt ONE repair (start) + rerun.
  if ! run_check backend chk_backend; then
    local backend_idx=$(( ${#R_NAME[@]} - 1 ))
    log "backend down — attempting bounded repair (start), then one rerun"
    cmd_start >/dev/null 2>&1 || true
    if run_check backend-rerun chk_backend; then
      # Transient healed: relabel the original failure so it is not terminal.
      R_STATUS[backend_idx]="REPAIRED"
    fi
  fi
  run_check frontend      chk_frontend || true
  run_check build         chk_build || true
  run_check migration013  chk_migration013 || true
  run_check local-sandbox chk_localsandbox || true
  run_check quantum-green  chk_quantum || true
  run_check repo-isolation chk_repo_isolation || true

  # Emit machine-readable report (built in bash for portability).
  {
    echo "{"
    echo "  \"generated_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\","
    echo "  \"checks\": ["
    local n=${#R_NAME[@]} i
    for i in $(seq 0 $((n-1))); do
      local sep=","; [ "$i" -eq $((n-1)) ] && sep=""
      printf '    {"name":"%s","status":"%s","ms":%s,"detail":"%s"}%s\n' \
        "${R_NAME[$i]}" "${R_STATUS[$i]}" "${R_MS[$i]}" "${R_DETAIL[$i]}" "$sep"
    done
    echo "  ]"
    echo "}"
  } > "$REPORT"

  local fails=0 i
  for i in "${!R_STATUS[@]}"; do [ "${R_STATUS[$i]}" = "FAIL" ] && fails=$((fails+1)); done
  echo "report: $REPORT"
  if [ "$fails" -eq 0 ]; then c_green "doctor: PASS (all ${#R_NAME[@]} checks)"; return 0; fi
  c_red "doctor: FAIL ($fails/${#R_NAME[@]} checks failed)"; return 1
}

# --------------------------------------------------------------------- dispatch
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    setup)          cmd_setup "$@" ;;
    start)          cmd_start "$@" ;;
    status)         cmd_status "$@" ;;
    health)         cmd_health "$@" ;;
    verify)         cmd_verify "$@" ;;
    doctor)         cmd_doctor "$@" ;;
    skill-new)      cmd_skill_new "$@" ;;
    skill-validate) cmd_skill_validate "$@" ;;
    help|-h|--help) usage ;;
    *) echo "unknown command: $cmd"; echo; usage; exit 2 ;;
  esac
}
main "$@"
