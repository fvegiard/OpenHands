{
  "name": "quantum-agent",
  "version": "0.1.0",
  "description": "The most advanced personal AI agent — quantum loop on the Claude Agent SDK.",
  "type": "module",
  "bin": {
    "quantum": "./src/cli.ts"
  },
  "scripts": {
    "quantum": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "test": "vitest run",
    "verify": "tsx src/cli.ts verify",
    "lint": "biome check . --write",
    "build": "tsc -p tsconfig.json --noEmit",
    "green": "biome check . --write && tsc -p tsconfig.json --noEmit && vitest run && tsx src/cli.ts verify",
    "electron:dev": "concurrently -k \"tsx src/cli.ts serve -p 8765\" \"cd electron && npx vite --port 5173\" \"wait-on http://127.0.0.1:8765 && cd electron && npx electron . --dev\"",
    "electron:build": "cd electron && npx tsc && npx vite build && npx electron-builder",
    "electron:preview": "cd electron && npx electron ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@hono/node-server": "^1.13.0",
    "@types/react-dom": "18.3.7",
    "chokidar": "^4.0.1",
    "commander": "^13.0.0",
    "concurrently": "^9.1.0",
    "electron-store": "^8.2.0",
    "execa": "^9.5.0",
    "hono": "^4.6.0",
    "ink": "^5.0.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.0",
    "react-dom": "18.3.1",
    "undici": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.18.2"
}
