{
  "name": "quantum-agent",
  "version": "0.1.0",
  "description": "The most advanced personal AI agent — quantum loop on the Claude Agent SDK.",
  "type": "module",
  "bin": {
    "quantum": "./src/cli.ts"
  },
  "scripts": {
    "quantum": "node --disable-warning=DEP0205 --import tsx src/cli.ts",
    "dev": "node --disable-warning=DEP0205 --import tsx --watch src/cli.ts",
    "test": "vitest run",
    "test:json": "vitest run --reporter=default --reporter=json --outputFile=.vitest-results.json",
    "verify": "node --disable-warning=DEP0205 --import tsx src/cli.ts verify",
    "verify:results": "node --disable-warning=DEP0205 --import tsx src/cli.ts verify --capabilities-results .vitest-results.json --require-results",
    "lint": "biome check . --write",
    "build": "tsc -p tsconfig.json --noEmit",
    "green": "biome check . --write && tsc -p tsconfig.json --noEmit && pnpm test:json && pnpm verify:results"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@hono/node-server": "^1.13.0",
    "chokidar": "^4.0.1",
    "commander": "^13.0.0",
    "execa": "^9.5.0",
    "hono": "^4.6.0",
    "ink": "^5.0.0",
    "react": "^18.3.0",
    "undici": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vercel-minimax-ai-provider": "^0.0.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
