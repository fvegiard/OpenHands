# Quantum Agent — environment template
# Copy to .env and fill in.

# OAuth token from your Claude Pro/Max plan.
# Get one with: `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Optional fallback — used only if OAuth token is absent.
# ANTHROPIC_API_KEY=

# Local-only bearer token for `quantum serve`.
# QUANTUM_BEARER_TOKEN=change-me

# GitHub token for the GitHub MCP integration.
# GITHUB_TOKEN=
