node_modules/
dist/
coverage/
.quantum/
.env
.env.local
*.log
.DS_Store

# Skills are pulled at runtime by `quantum init`.
skills/*
!skills/.gitkeep

# The repo-root .gitignore has `cache` (line 244) which would otherwise
# swallow our src/cache/ directory. Force-include it.
!src/cache/
!src/cache/**
